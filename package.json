{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "description": "Distributed Wagering Processor - iGaming Financial Service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch run src/main.ts",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx eslint src --ext .ts",
    "typecheck": "bunx tsc --noEmit",
    "db:generate": "bunx mikro-orm migration:create",
    "db:migrate": "bunx mikro-orm migration:up",
    "db:schema": "bunx mikro-orm schema:update --run"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.490.0",
    "@mikro-orm/core": "^6.2.0",
    "@mikro-orm/postgresql": "^6.2.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/swagger": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@mikro-orm/migrations": "^6.2.0",
    "@types/bun": "latest",
    "@types/node": "^20.11.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}